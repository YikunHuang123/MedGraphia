# ============================================================================
# MedGraphia — FastAPI image  (multi-stage)
# Stage 1: build — installs all deps (including heavy ML libs)
# Stage 2: runtime — copies only the installed packages and source
# ============================================================================

# ---- Stage 1: build --------------------------------------------------------
FROM python:3.12-slim AS builder

WORKDIR /build

# System dependencies for lxml, Pillow, pytesseract
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ libxml2-dev libxslt-dev libjpeg-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies into a prefix directory (for clean copy)
COPY pyproject.toml .
RUN pip install --no-cache-dir --prefix=/install ".[dev]" 2>/dev/null || \
    pip install --no-cache-dir --prefix=/install .

# ---- Stage 2: runtime ------------------------------------------------------
FROM python:3.12-slim AS runtime

WORKDIR /app

# Runtime system libs
RUN apt-get update && apt-get install -y --no-install-recommends \
        tesseract-ocr tesseract-ocr-eng tesseract-ocr-deu tesseract-ocr-chi-sim \
        libxml2 libxslt1.1 libjpeg62-turbo curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed Python packages from builder
COPY --from=builder /install /usr/local

# Copy application source
COPY src/ /app/src/

ENV PYTHONPATH=/app/src
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

EXPOSE 8058

CMD ["uvicorn", "medgraphia.api:create_app", "--factory", \
     "--host", "0.0.0.0", "--port", "8058", "--workers", "2"]
