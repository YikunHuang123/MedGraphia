# ============================================================================
# MedGraphia — FastAPI image  (multi-stage)
# Stage 1: builder — installs all Python deps; needs src/ for setuptools
# Stage 2: runtime — copies only the installed packages + system ML libs
# ============================================================================

# ---- Stage 1: builder ------------------------------------------------------
FROM python:3.12-slim AS builder

WORKDIR /build

# C-extension build deps (lxml, Pillow, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ libxml2-dev libxslt-dev libjpeg-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy both pyproject.toml AND src/ so setuptools can discover the package
COPY pyproject.toml .
COPY src/ src/

# Install into a separate prefix so we can cherry-pick it into the runtime stage
RUN pip install --no-cache-dir --prefix=/install .

# ---- Stage 2: runtime ------------------------------------------------------
FROM python:3.12-slim AS runtime

WORKDIR /app

# Runtime system libs (tesseract for OCR fallback, curl for healthchecks)
RUN apt-get update && apt-get install -y --no-install-recommends \
        tesseract-ocr tesseract-ocr-eng tesseract-ocr-deu tesseract-ocr-chi-sim \
        libxml2 libxslt1.1 libjpeg62-turbo curl \
    && rm -rf /var/lib/apt/lists/*

# Drop the fully-built Python environment from the builder stage
COPY --from=builder /install /usr/local

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

EXPOSE 8058

# factory mode lets uvicorn call create_app() each worker fork
CMD ["uvicorn", "medgraphia.api:create_app", "--factory", \
     "--host", "0.0.0.0", "--port", "8058", "--workers", "2"]
