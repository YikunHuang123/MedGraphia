# ============================================================================
# MedGraphia — Streamlit UI image
# Lightweight: installs only UI packages (no torch/transformers).
# The full src/ tree is copied so medgraphia.domain.* types are importable.
# ============================================================================

FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# UI-specific packages + the minimal medgraphia runtime deps
# (pydantic-settings / python-dotenv needed if any page imports medgraphia.config)
RUN pip install --no-cache-dir \
    streamlit>=1.35.0 \
    httpx>=0.27.0 \
    pydantic>=2.7.0 \
    pydantic-settings>=2.3.0 \
    python-dotenv>=1.0.0 \
    pyvis>=0.3.2 \
    pandas>=2.2.0 \
    plotly>=5.22.0

# Copy the full source tree so all medgraphia.* imports resolve correctly
COPY src/ /app/src/

# src-layout: tell Python where to find the medgraphia package
ENV PYTHONPATH=/app/src
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

EXPOSE 8501

CMD ["streamlit", "run", "/app/src/medgraphia/ui/streamlit_app.py", \
     "--server.port=8501", "--server.address=0.0.0.0", \
     "--server.headless=true"]
