# ============================================================================
# MedGraphia — Pipeline worker image (Arq async task-queue worker)
# Includes heavier ML dependencies: torch, transformers, FlagEmbedding, docling
# ============================================================================

# ---- Stage 1: builder ------------------------------------------------------
FROM python:3.12-slim AS builder

WORKDIR /build

# Build deps: C extensions + tesseract for the OCR pipeline stage
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ libxml2-dev libxslt-dev libjpeg-dev zlib1g-dev \
        tesseract-ocr tesseract-ocr-eng tesseract-ocr-deu tesseract-ocr-chi-sim \
        git \
    && rm -rf /var/lib/apt/lists/*

# Copy both pyproject.toml AND src/ so setuptools can discover the package
COPY pyproject.toml .
COPY src/ src/

RUN pip install --no-cache-dir --prefix=/install ".[ingestion]"

# ---- Stage 2: runtime ------------------------------------------------------
FROM python:3.12-slim AS runtime

WORKDIR /app

# Runtime system libs (tesseract for pipeline OCR, curl for health probes)
RUN apt-get update && apt-get install -y --no-install-recommends \
        tesseract-ocr tesseract-ocr-eng tesseract-ocr-deu tesseract-ocr-chi-sim \
        libxml2 libxslt1.1 libjpeg62-turbo curl git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local

# Pipeline CLI scripts (used via `docker compose exec worker python scripts/...`)
COPY scripts/ /app/scripts/

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Start the Arq worker; it listens to Redis and runs task_build_pipeline jobs
CMD ["arq", "medgraphia.worker.WorkerSettings"]
