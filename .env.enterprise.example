# =============================================================================
# MedGraphia — Enterprise Mode Environment Template
# Copy to .env and fill in real values. Never commit .env to git.
# =============================================================================

# ---------------------------------------------------------------------------
# Storage Backend: "s3" or "local"
# ---------------------------------------------------------------------------
STORAGE_BACKEND=s3

# ---------------------------------------------------------------------------
# Auth Strategy: "none", "apikey", or "oidc"
# ---------------------------------------------------------------------------
AUTH_STRATEGY=oidc

# ---------------------------------------------------------------------------
# Neo4j
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j
NEO4J_PAGE_CACHE=4G
NEO4J_HEAP_INITIAL=1G
NEO4J_HEAP_MAX=4G

# ---------------------------------------------------------------------------
# Vector store: "qdrant"
# ---------------------------------------------------------------------------
VECTOR_STORE=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_CHUNKS=medgraphia_chunks
QDRANT_COLLECTION_ENTITIES=medgraphia_entities

# ---------------------------------------------------------------------------
# Embedding  (BGE-M3 via text-embeddings-inference, or Ollama)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=http://embedding:8080
EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------------------
# LLM — pick one provider (deepseek | openai | anthropic | ollama | local)
# ---------------------------------------------------------------------------
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

DEEPSEEK_API_KEY=sk-your-deepseek-key
OPENAI_API_KEY=sk-your-openai-key
OPENAI_base_url=https://api.openai.com/v1
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# LLM used for Leiden community summary generation (defaults to LLM_MODEL)
COMMUNITY_SUMMARY_LLM=

# ---------------------------------------------------------------------------
# Safety guardrails
# ---------------------------------------------------------------------------
GUARDRAILS_ENABLED=true
LLAMA_GUARD_MODEL=meta-llama/Llama-Guard-4-8B
RAGAS_FAITHFULNESS_THRESHOLD=0.75

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
TRACING_ENABLED=true
METRICS_ENABLED=true
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key

# ---------------------------------------------------------------------------
# Object storage — S3 (MinIO/AWS)
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=medgraphia-raw
MINIO_BUCKET_PARSED=medgraphia-parsed
MINIO_SECURE=false

# ---------------------------------------------------------------------------
# Pipeline / data ingestion
# ---------------------------------------------------------------------------
DEFAULT_DOMAIN=general
PUBMED_MAX_RESULTS=500
PUBMED_EMAIL=your-email@example.com
PUBMED_API_KEY=
DRUG_LABEL_LIMIT=50

# ---------------------------------------------------------------------------
# Privacy / compliance
# ---------------------------------------------------------------------------
PII_DEIDENTIFY=true

# ---------------------------------------------------------------------------
# GraphRAG framework
# ---------------------------------------------------------------------------
GRAPHRAG_FRAMEWORK=lightrag

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8058
LOG_LEVEL=INFO
