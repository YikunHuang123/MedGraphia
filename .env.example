# =============================================================================
# MedGraphia — Environment Template
# Copy to .env and fill in real values. Never commit .env to git.
# =============================================================================

# ---------------------------------------------------------------------------
# Storage Backend: "local" or "s3"
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local

# ---------------------------------------------------------------------------
# Auth Strategy: "none", "apikey", or "oidc"
# ---------------------------------------------------------------------------
AUTH_STRATEGY=apikey

# ---------------------------------------------------------------------------
# Neo4j
# Tune NEO4J_PAGE_CACHE and NEO4J_HEAP_MAX based on available RAM.
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j
NEO4J_PAGE_CACHE=1G
NEO4J_HEAP_INITIAL=512M
NEO4J_HEAP_MAX=1G

# ---------------------------------------------------------------------------
# Vector store: "qdrant"
# ---------------------------------------------------------------------------
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_CHUNKS=medgraphia_chunks
QDRANT_COLLECTION_ENTITIES=medgraphia_entities

# ---------------------------------------------------------------------------
# Embedding
# Option A — Ollama (local, zero API cost):
#   EMBEDDING_PROVIDER=ollama
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_BASE_URL=http://localhost:11434
# Option B — HuggingFace text-embeddings-inference (BGE-M3):
#   EMBEDDING_PROVIDER=huggingface
#   EMBEDDING_MODEL=BAAI/bge-m3
#   EMBEDDING_BASE_URL=http://embedding:8080
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_BATCH_SIZE=8

# ---------------------------------------------------------------------------
# LLM (Default Fallback)
# Option A — Ollama (local, zero API cost):
#   DEFAULT_LLM_PROVIDER=ollama
#   DEFAULT_LLM_MODEL=qwen2.5:7b
#   LLM_BASE_URL=http://localhost:11434
# Option B — DeepSeek API (cheap, cloud):
#   DEFAULT_LLM_PROVIDER=deepseek
#   DEFAULT_LLM_MODEL=deepseek-chat
#   DEEPSEEK_API_KEY=sk-your-deepseek-key
# Option C — vLLM (self-hosted OpenAI-compatible server):
#   DEFAULT_LLM_PROVIDER=vllm
#   DEFAULT_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
#   VLLM_BASE_URL=http://localhost:8010/v1
# ---------------------------------------------------------------------------
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://localhost:11434
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# Only used when a tier's provider is set to "vllm" — kept separate from
# LLM_BASE_URL so it never collides with DeepSeek's base-url override.
VLLM_BASE_URL=http://localhost:8010/v1

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Task-specific LLM overrides (leave empty to use the DEFAULT_LLM_* settings)
REWRITER_LLM_PROVIDER=
REWRITER_LLM_MODEL=
REWRITER_LLM_API_KEY=
REWRITER_LLM_BASE_URL=

EXTRACTOR_LLM_PROVIDER=
EXTRACTOR_LLM_MODEL=
EXTRACTOR_LLM_API_KEY=
EXTRACTOR_LLM_BASE_URL=

SUMMARIZER_LLM_PROVIDER=
SUMMARIZER_LLM_MODEL=
SUMMARIZER_LLM_API_KEY=
SUMMARIZER_LLM_BASE_URL=

# LLM used for Leiden community summary generation (defaults to DEFAULT_LLM_MODEL)
COMMUNITY_SUMMARY_LLM=

# ---------------------------------------------------------------------------
# LLM Router — per-tier model overrides
# ---------------------------------------------------------------------------
LLM_SMALL_PROVIDER=vllm
LLM_SMALL_MODEL=Qwen/Qwen2.5-3B-Instruct
LLM_MEDIUM_PROVIDER=deepseek
LLM_MEDIUM_MODEL=deepseek-v4-flash
LLM_LARGE_PROVIDER=deepseek
LLM_LARGE_MODEL=deepseek-v4-pro

# Judge LLM (used for evaluations and quality metrics)
JUDGE_LLM_PROVIDER=deepseek
JUDGE_LLM_MODEL=deepseek-chat
JUDGE_LLM_API_KEY=
JUDGE_LLM_BASE_URL=

# ---------------------------------------------------------------------------
# Safety guardrails
# Set GUARDRAILS_ENABLED=true if you have enough VRAM for llama-guard3:1b.
# ---------------------------------------------------------------------------
GUARDRAILS_ENABLED=false
LLAMA_GUARD_PROVIDER=ollama
LLAMA_GUARD_MODEL=llama-guard3:1b
RAGAS_FAITHFULNESS_THRESHOLD=0.75

# ---------------------------------------------------------------------------
# Observability — Langfuse (self-hosted)
# ---------------------------------------------------------------------------
TRACING_ENABLED=false
METRICS_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Redis — NER result cache + Arq task-queue broker
# Set to empty string to disable Redis (pipeline falls back to in-process execution).
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Pipeline / data ingestion
# ---------------------------------------------------------------------------
DEFAULT_DOMAIN=t2dm
PUBMED_MAX_RESULTS=200
PUBMED_EMAIL=your-email@example.com
PUBMED_API_KEY=
DRUG_LABEL_LIMIT=30

# ---------------------------------------------------------------------------
# NER models
# ---------------------------------------------------------------------------
NER_GLINER_MODEL=Ihor/gliner-biomed-large-v1.0
NER_GLINER_THRESHOLD=0.30
NER_BERT_EN_MODEL=d4data/biomedical-ner-all
NER_BERT_ZH_MODEL=Adapting/bert-base-chinese-finetuned-NER-biomedical
NER_BERT_DE_MODEL=BachelorThesis/GerMedBERT_NER_V01_BRONCO_CARDIO
NER_CONFIDENCE_THRESHOLD=0.25

# ---------------------------------------------------------------------------
# Entity Linking (SapBERT → MeSH CUI)
# ---------------------------------------------------------------------------
EL_SAPBERT_MODEL=cambridgeltl/SapBERT-UMLS-2020AB-all-lang-from-XLMR
EL_BM25_TOP_K=50
EL_LINK_THRESHOLD=0.70
EL_SAPBERT_THRESHOLD=0.75
MESH_DIR=data/mesh

# ---------------------------------------------------------------------------
# Multilingual retrieval
# ---------------------------------------------------------------------------
MULTILINGUAL_RETRIEVAL_ENABLED=true
MULTILINGUAL_PER_LANG_QUOTA=7

# ---------------------------------------------------------------------------
# Privacy / compliance
# ---------------------------------------------------------------------------
PII_DEIDENTIFY=false

# ---------------------------------------------------------------------------
# GraphRAG framework
# ---------------------------------------------------------------------------
GRAPHRAG_FRAMEWORK=lightrag

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
ADMIN_BOOTSTRAP_KEY=change-me
API_HOST=0.0.0.0
API_PORT=8058
LOG_LEVEL=INFO
